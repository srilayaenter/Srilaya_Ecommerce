# ─────────────────────────────────────────────────────────────────────────────
# SriLaYa Naturals — Staging Environment Variables
# Copy this file to .env.staging (gitignored) and fill in real values.
# Set these in the Vercel Dashboard → Project → Settings → Environment Variables
#   → scope: "Preview" → Git Branch: staging
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Supabase staging project — free tier) ──────────────────────────
# Create at: supabase.com → New project → name: srilaya-staging
# Connection string: Project Settings → Database → Connection string → URI
# Use pgBouncer (port 6543) for the pooled URL, direct (port 5432) for migrations
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&sslmode=require"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require"

# ── Auth ──────────────────────────────────────────────────────────────────────
# Set to Vercel's stable branch alias for the staging branch.
# Find it in: Vercel Dashboard → Project → Deployments → filter by Branch: staging
# It looks like: https://srilaya-ecommerce-git-staging-<team>.vercel.app
NEXTAUTH_URL="https://srilaya-ecommerce-git-staging-<your-vercel-team>.vercel.app"
# Generate: openssl rand -base64 32   (can differ from production)
NEXTAUTH_SECRET="<generate-with-openssl-rand-base64-32>"

# ── Razorpay TEST keys ────────────────────────────────────────────────────────
# Source: razorpay.com → Dashboard → top-right toggle → TEST MODE
#         Settings → API Keys → Generate Test Key
# These keys only accept test card numbers — no real money moves.
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="<test-key-secret>"
# Webhooks → Add New Webhook → URL: <NEXTAUTH_URL>/api/webhooks/razorpay → copy secret
RAZORPAY_WEBHOOK_SECRET="<test-webhook-secret>"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxxxx"

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Create a separate OAuth client for staging:
# console.cloud.google.com → Credentials → Create OAuth client ID → Web
# Authorised redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID="<staging-client-id>.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="<staging-client-secret>"

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Use a separate Resend API key with a staging subdomain, or re-use prod key.
# Easiest: create resend.com → API Keys → add key named "srilaya-staging"
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
ADMIN_ALERT_EMAIL="staging-alerts@srilayafoods.com"
FROM_EMAIL="staging-noreply@srilayafoods.com"

# ── Supabase Storage ──────────────────────────────────────────────────────────
# Use the staging Supabase project's URL and anon key.
# Project Settings → API → Project URL & anon/public key
NEXT_PUBLIC_SUPABASE_URL="https://<staging-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<staging-anon-key>"
SUPABASE_SERVICE_ROLE_KEY="<staging-service-role-key>"

# ── GSC Verification ──────────────────────────────────────────────────────────
# Leave blank in staging — staging site should not be registered with GSC
NEXT_PUBLIC_GSC_VERIFICATION=""

# ── Sentry ────────────────────────────────────────────────────────────────────
# Option A: use the same project, staging environment
# Option B: leave blank to disable error reporting in staging
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# ── PostHog Analytics ────────────────────────────────────────────────────────
# Leave blank to disable analytics in staging, or use a separate PostHog project
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST=""

# ── Axiom Logging ────────────────────────────────────────────────────────────
NEXT_PUBLIC_AXIOM_DATASET=""
NEXT_PUBLIC_AXIOM_TOKEN=""

# ── App Config ────────────────────────────────────────────────────────────────
NODE_ENV="production"
# VERCEL_ENV is set automatically by Vercel to "preview" for staging deployments
# — do not set it manually; next.config.js reads it to inject X-Robots-Tag: noindex
