generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String?        @unique
  password      String?
  role          String         @default("customer")
  createdAt     DateTime       @default(now())
  active        Boolean        @default(true)
  totpEnabled   Boolean        @default(false)
  totpSecret    String?
  phone         String?        @unique
  carts           Cart[]
  orders          Order[]
  wishlistItems   WishlistItem[]
  mfaTotpAttempts MfaTotpAttempt[]
  activationTokens StaffActivationToken[]
}

model PhoneOtp {
  id        String   @id @default(cuid())
  phone     String
  otp       String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Category {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  image       String?
  parentId    String?
  description String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]
}

model Product {
  id             String           @id @default(cuid())
  slug           String           @unique
  title          String
  description    String?
  currency       String           @default("INR")
  gstRate        Decimal          @db.Decimal(4, 2)
  sku            String           @unique
  active         Boolean          @default(true)
  image          String?
  rating         Decimal?         @db.Decimal(3, 2)
  reviews        Int              @default(0)
  categoryId     String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  supplierId     String?
  category       Category         @relation(fields: [categoryId], references: [id])
  supplier       Supplier?        @relation(fields: [supplierId], references: [id])
  images         ProductImage[]
  productReviews ProductReview[]
  variants       ProductVariant[]
  wishlistItems  WishlistItem[]
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductReview {
  id           String   @id @default(cuid())
  productId    String
  orderId      String?
  customerName String
  email        String
  rating       Int
  comment      String?
  approved     Boolean  @default(false)
  createdAt    DateTime @default(now())
  photoUrl     String?
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductVariant {
  id                 String              @id @default(cuid())
  productId          String
  size               String
  price              Decimal             @db.Decimal(10, 2)
  stock              Int                 @default(100)
  sku                String              @unique
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  weightGrams        Int                 @default(500)
  reorderThreshold   Int                 @default(10)
  imageUrl           String?
  costPrice          Decimal?            @db.Decimal(10, 2)
  active             Boolean             @default(true)
  bundleItems        BundleItem[]
  cartItems          CartItem[]
  ladduRecipe        LadduRecipe?
  orderItems         OrderItem[]
  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  productionBatches  ProductionBatch[]
  stockNotifications StockNotification[]

  @@unique([productId, size])
}

model Bundle {
  id          String       @id @default(cuid())
  slug        String       @unique
  title       String
  description String?
  image       String?
  price       Decimal      @db.Decimal(10, 2)
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  items       BundleItem[]
}

model BundleItem {
  id        String         @id @default(cuid())
  bundleId  String
  variantId String
  quantity  Int            @default(1)
  bundle    Bundle         @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([bundleId, variantId])
}

model Cart {
  id             String     @id @default(cuid())
  userId         String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  email          String?
  reminderSentAt DateTime?
  user           User?      @relation(fields: [userId], references: [id])
  items          CartItem[]
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int            @default(1)
  price     Decimal        @db.Decimal(10, 2)
  gstRate   Decimal        @db.Decimal(4, 2)
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
}

model Order {
  id                String      @id @default(cuid())
  userId            String?
  subtotal          Decimal     @db.Decimal(10, 2)
  taxTotal          Decimal     @db.Decimal(10, 2)
  shippingFee       Decimal     @db.Decimal(10, 2)
  total             Decimal     @db.Decimal(10, 2)
  currency          String      @default("INR")
  status            String      @default("pending")
  paymentId         String?
  invoiceNo         String?
  customerName      String?
  email             String?
  phone             String?
  address           String?
  city              String?
  state             String?
  zipCode           String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  fulfillmentStatus String      @default("pending")
  orderChannel      String      @default("online")
  paymentMethod     String?
  couponCode        String?
  discountAmount    Decimal?    @db.Decimal(10, 2)
  referralCode      String?
  codPaymentMethod  String?
  codUpiRef         String?
  user              User?       @relation(fields: [userId], references: [id])
  items             OrderItem[]
  returns           Return[]
  shipment          Shipment?
}

model Shipment {
  id                String    @id @default(cuid())
  orderId           String    @unique
  courier           String
  trackingNumber    String
  trackingUrl       String?
  status            String    @default("booked")
  shippedAt         DateTime?
  estimatedDelivery DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  order             Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderItem {
  id        String         @id @default(cuid())
  orderId   String
  variantId String
  quantity  Int
  price     Decimal        @db.Decimal(10, 2)
  gstRate   Decimal        @db.Decimal(4, 2)
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id])
}

model PaymentAuditLog {
  id                String   @id @default(cuid())
  orderId           String?
  eventType         String
  razorpayOrderId   String?
  razorpayPaymentId String?
  amount            Decimal? @db.Decimal(10, 2)
  status            String
  ipAddress         String?
  userAgent         String?
  userId            String?
  metadata          Json?
  createdAt         DateTime @default(now())

  @@index([orderId])
  @@index([razorpayOrderId])
  @@index([eventType])
  @@index([createdAt])
}

model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  eventId     String   @unique
  processedAt DateTime @default(now())
}

model FailedWebhook {
  id           String    @id @default(cuid())
  provider     String
  eventId      String?
  rawBody      String
  errorMessage String
  retries      Int       @default(0)
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([provider])
  @@index([resolvedAt])
}

model FailedEmail {
  id           String    @id @default(cuid())
  to           String
  subject      String
  html         String
  context      String?
  errorMessage String
  retriedAt    DateTime?
  resolved     Boolean   @default(false)
  createdAt    DateTime  @default(now())
}

model Supplier {
  id             String          @id @default(cuid())
  name           String
  contactPerson  String?
  phone          String?
  email          String?
  address        String?
  notes          String?
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  bankAccount    String?
  bankIfsc       String?
  bankName       String?
  gstin          String?
  leadTimeDays   Int?
  paymentTerms   String?
  rating         Int?
  packagingItems PackagingItem[]
  products       Product[]
  purchaseOrders PurchaseOrder[]
}

model PurchaseOrder {
  id         String              @id @default(cuid())
  supplierId String
  status     String              @default("draft")
  note       String?
  expectedAt DateTime?
  receivedAt DateTime?
  createdBy  String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  supplier   Supplier            @relation(fields: [supplierId], references: [id])
  items      PurchaseOrderItem[]

  @@index([supplierId])
  @@index([status])
}

model PurchaseOrderItem {
  id               String        @id @default(cuid())
  purchaseOrderId  String
  variantId        String
  sku              String
  quantityOrdered  Int
  quantityReceived Int           @default(0)
  unitCost         Decimal?      @db.Decimal(10, 2)
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
}

model Coupon {
  id        String    @id @default(cuid())
  code      String    @unique
  type      String
  value     Decimal   @db.Decimal(10, 2)
  minOrder  Decimal?  @db.Decimal(10, 2)
  maxUses   Int?
  usedCount Int       @default(0)
  expiresAt DateTime?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
}

model Return {
  id        String       @id @default(cuid())
  orderId   String
  reason    String
  status    String       @default("requested")
  adminNote String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items     ReturnItem[]
}

model ReturnItem {
  id        String @id @default(cuid())
  returnId  String
  variantId String
  title     String
  size      String
  quantity  Int
  return    Return @relation(fields: [returnId], references: [id], onDelete: Cascade)
}

model StockNotification {
  id         String         @id @default(cuid())
  email      String
  variantId  String
  notifiedAt DateTime?
  createdAt  DateTime       @default(now())
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([email, variantId])
}

model LoyaltyAccount {
  id           String               @id @default(cuid())
  email        String               @unique
  balance      Int                  @default(0)
  totalEarned  Int                  @default(0)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  referralCode String?              @unique
  transactions LoyaltyTransaction[]
}

model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String?
  content     String
  category    String    @default("article")
  image       String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  readMins    Int       @default(3)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model StockLog {
  id        String   @id @default(cuid())
  variantId String
  sku       String
  delta     Int
  reason    String
  note      String?
  userId    String?
  createdAt DateTime @default(now())

  @@index([variantId])
  @@index([createdAt])
}

model LoyaltyTransaction {
  id        String         @id @default(cuid())
  accountId String
  type      String
  points    Int
  orderId   String?
  note      String?
  createdAt DateTime       @default(now())
  account   LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model RawMaterial {
  id               String           @id @default(cuid())
  name             String           @unique
  unit             String           @default("kg")
  stockQty         Float            @default(0)
  costPerUnit      Float?
  reorderThreshold Float            @default(5)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  stockLogs        RawMaterialLog[]
  recipeLines      RecipeLine[]
}

model LadduRecipe {
  id        String         @id @default(cuid())
  variantId String         @unique
  yieldKg   Float          @default(1)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  lines     RecipeLine[]
}

model RecipeLine {
  id            String      @id @default(cuid())
  recipeId      String
  rawMaterialId String
  qtyPerYield   Float
  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id])
  recipe        LadduRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
}

model ProductionBatch {
  id            String           @id @default(cuid())
  variantId     String
  unitsProduced Int
  notes         String?
  producedAt    DateTime         @default(now())
  createdBy     String?
  variant       ProductVariant   @relation(fields: [variantId], references: [id])
  logs          RawMaterialLog[]
}

model PackagingItem {
  id               String              @id @default(cuid())
  name             String              @unique
  category         String
  unit             String              @default("pcs")
  stockQty         Int                 @default(0)
  reorderThreshold Int                 @default(50)
  costPerUnit      Decimal?            @db.Decimal(10, 2)
  supplierId       String?
  notes            String?
  active           Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  supplier         Supplier?           @relation(fields: [supplierId], references: [id])
  stockLogs        PackagingStockLog[]

  @@index([category])
  @@index([supplierId])
}

model PackagingStockLog {
  id              String        @id @default(cuid())
  packagingItemId String
  type            String
  qty             Int
  note            String?
  createdAt       DateTime      @default(now())
  packagingItem   PackagingItem @relation(fields: [packagingItemId], references: [id], onDelete: Cascade)

  @@index([packagingItemId])
  @@index([createdAt])
}

model RawMaterialLog {
  id            String           @id @default(cuid())
  rawMaterialId String
  type          String
  qty           Float
  note          String?
  batchId       String?
  createdAt     DateTime         @default(now())
  batch         ProductionBatch? @relation(fields: [batchId], references: [id])
  rawMaterial   RawMaterial      @relation(fields: [rawMaterialId], references: [id])

  @@index([rawMaterialId])
  @@index([createdAt])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

// SriLaYa Ops (kitchen/workshop batch-scaling app) shared recipe catalog.
// Read/written directly by the standalone Ops app (web + Android) via the
// Supabase anon key + RLS policies (see migration) — not through this
// Next.js app's own API routes.
model OpsRecipe {
  id         String   @id @default(cuid())
  name       String
  category   String
  details    String
  baseRatios Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([category])
}

model MfaTotpAttempt {
  id          String   @id @default(cuid())
  userId      String
  attemptedAt DateTime @default(now())
  succeeded   Boolean

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, attemptedAt])
}

model StaffActivationToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
