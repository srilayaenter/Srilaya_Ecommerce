{
  "name": "srilaya-ecommerce",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev apps/web",
    "build": "prisma generate --schema=./packages/db/schema.prisma && next build apps/web",
    "start": "next start apps/web",
    "prisma:generate": "prisma generate --schema=./packages/db/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=./packages/db/schema.prisma",
    "prisma:studio": "prisma studio --schema=./packages/db/schema.prisma",
    "seed": "tsx scripts/seed-variants.ts",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:regression": "playwright test tests/e2e/regression.spec.ts",
    "test:auth": "playwright test tests/e2e/auth.spec.ts",
    "test:mobile": "playwright test --project=mobile",
    "test:api": "playwright test tests/e2e/api/",
    "test:report": "playwright show-report tests/report"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@prisma/client": "6.19.3",
    "@sentry/nextjs": "^10.66.0",
    "@vercel/speed-insights": "^2.0.0",
    "autoprefixer": "10.4.19",
    "bcryptjs": "2.4.3",
    "next": "14.2.35",
    "next-auth": "4.24.14",
    "next-axiom": "^1.10.0",
    "otplib": "^13.4.1",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.19.1",
    "postcss": "8.4.41",
    "posthog-js": "^1.404.1",
    "qrcode": "^1.5.4",
    "razorpay": "2.9.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^4.0.0",
    "tailwindcss": "3.4.13",
    "twilio": "^6.0.2",
    "typescript": "5.9.3",
    "zod": "^4.4.3"
  },
  "prisma": {
    "schema": "packages/db/schema.prisma"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/bcryptjs": "2.4.2",
    "@types/node": "~20.19.43",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "prisma": "6.19.3",
    "ts-node": "10.9.2",
    "tsx": "^4.22.4"
  }
}
