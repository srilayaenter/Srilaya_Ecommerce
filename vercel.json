{
  "installCommand": "pnpm install --no-frozen-lockfile",
  "crons": [
    {
      "path": "/api/cron/release-stock",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/low-stock-check",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/abandoned-cart",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/cleanup-failed-emails",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/cleanup-payment-audit",
      "schedule": "0 3 * * *"
    }
  ]
}